# Trading212 API key + secret (generate in the Trading212 app: Settings -> API)
T212_API_KEY=
T212_API_SECRET=

# "demo" = practice account (recommended), "live" = real money
T212_ENV=demo

# When true, the bot only logs the orders it WOULD place
DRY_RUN=true

# Required safety latch before the bot will touch a live account
I_UNDERSTAND_LIVE_TRADING_RISK=no

# Intraday market data for the day-trade bot only (t212bot/data.py). Free,
# data-only Alpaca account -- no funding needed. Generate a key at
# https://app.alpaca.markets (API Keys, "Paper" account is fine for data).
# The swing bot doesn't need these -- it still runs on yfinance daily bars.
ALPACA_API_KEY=
ALPACA_API_SECRET=
DAYTRADE_BAR_MINUTES=5
# Extra safety gate on entry only: requires this many trailing 1-minute
# closes to hold above the opening-range breakout level before buying, so a
# breakout that spikes above the range on one 5-min bar and immediately
# fades doesn't get bought. 0 disables it (and skips the extra data fetch).
DAYTRADE_CONFIRM_BARS=3
# Hard entry gate: rejects a breakout unless EMA(9)/EMA(21) have separated by
# at least this fraction of the slow EMA -- filters out weak/marginal
# "uptrends" that are disproportionately fakeouts. 0 disables it. Backtested
# across 30 symbols / 60 days: raised win rate 30.5% -> 33.1%, cut avg
# drawdown by a third (see t212bot/backtest.py, t212bot/strategy.py).
DAYTRADE_MIN_EMA_SPREAD_PCT=0.001
# Fixed stop-loss/take-profit, checked each cycle against the latest bar's
# Low/High against the real average fill price -- see run_day_trade_cycle in
# t212bot/bot.py. Not a resting broker order, a polling check. 0 disables
# either side independently. Backtested: cut worst-case single-window
# drawdown roughly in half with no meaningful cost to average return.
DAYTRADE_STOP_LOSS_PCT=0.01
DAYTRADE_TAKE_PROFIT_PCT=0.02

# Comma-separated Yahoo Finance symbols to scan
WATCHLIST=AAPL,MSFT,GOOGL,AMZN,NVDA,META,TSLA,JPM,V,UNH,HD,XOM,JNJ,PG,DIS,AVGO,CRM,NFLX,NKE,MCD,BAC,MA,PFE,ABBV,CVX,KO,WMT,BA,CAT,NEE

# Risk settings
MAX_POSITION_PCT=0.35      # hard ceiling: max 35% of account value per position (scaled down by signal strength -- see below)
MAX_OPEN_POSITIONS=10      # up to 10 * MAX_POSITION_PCT of account value invested at once
CASH_BUFFER_PCT=0.05       # keep 5% of account value in cash

# Volatility-aware position sizing (see README): position size targets losing
# about RISK_PER_TRADE_PCT of the account if price moves ATR_MULTIPLE x ATR
# against it -- a volatile stock gets a smaller position than a calm one for
# the same dollar risk. MAX_POSITION_PCT above still applies as a hard cap.
RISK_PER_TRADE_PCT=0.01
ATR_MULTIPLE=2.0
ATR_PERIOD=14

# Daily target/loss-limit (not a guarantee — see README). Once realized gains
# for the day reach the target, new entries pause; same for losses hitting
# the limit. Shared across both bots, resets at UTC midnight.
DAILY_PROFIT_TARGET_PCT=0.0075   # 0.75% — stop opening new positions once hit
DAILY_LOSS_LIMIT_PCT=0.01        # 1% — stop opening new positions once hit

# Per-symbol losing-streak circuit breaker (rule-based, not ML — see README).
# After this many losses in a row on one symbol, pause new entries on just
# that symbol for the cooldown period, then resume with a reset streak.
LOSING_STREAK_LIMIT=3
LOSING_STREAK_COOLDOWN_DAYS=5

# Portfolio-level risk (see README): caps that look at the whole account
# rather than one symbol at a time.
# Max fraction of account value held in any one sector at once (t212bot/sectors.py),
# so a handful of correlated names (e.g. big tech) can't fill every open slot.
MAX_SECTOR_EXPOSURE_PCT=0.35
# Account-wide drawdown throttle: once realized returns fall this far below
# their high-water mark, both bots stop opening new positions until it
# recovers to less than half this threshold.
MAX_PORTFOLIO_DRAWDOWN_PCT=0.15
