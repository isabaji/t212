# Trading212 API key + secret (generate in the Trading212 app: Settings -> API)
T212_API_KEY=
T212_API_SECRET=

# "demo" = practice account (recommended), "live" = real money
T212_ENV=demo

# When true, the bot only logs the orders it WOULD place
DRY_RUN=true

# Required safety latch before the bot will touch a live account
I_UNDERSTAND_LIVE_TRADING_RISK=no

# Intraday market data for the day-trade bot only (t212bot/data.py). Free,
# data-only Alpaca account -- no funding needed. Generate a key at
# https://app.alpaca.markets (API Keys, "Paper" account is fine for data).
# The swing bot doesn't need these -- it still runs on yfinance daily bars.
ALPACA_API_KEY=
ALPACA_API_SECRET=
DAYTRADE_BAR_MINUTES=5
# The live day-trade bot (`python main.py daytrade`) always runs the
# validated 3-way ORB+MeanReversion+GapFillReversal ensemble (2 of 3 must
# agree, and ORB must be one of them) -- see README.md. The
# standalone/pairwise strategies are still available for comparison via
# `python main.py backtest --daytrade --strategy orb`, which uses this as
# its default confirm-bars gate (requires this many trailing 1-minute closes
# to hold above the opening-range breakout level before buying, so a
# breakout that spikes above the range on one 5-min bar and immediately
# fades doesn't get bought). 0 disables it. Not used by the live bot -- its
# ensemble's ORB component always runs with confirm bars disabled.
DAYTRADE_CONFIRM_BARS=3
# Minutes after the day-trade cron window opens (13:00 UTC) before the bot
# will open any new position -- it still fetches data, evaluates signals, and
# logs decisions from the window's start, this only delays entries. Exits
# (signal SELL, stop-loss/take-profit, EOD flatten) are never delayed. 0
# disables the gate. Default 25 = orders start at 13:25 UTC (2:25pm BST in UK
# summer time).
DAYTRADE_ENTRY_DELAY_MINUTES=25
# Fixed stop-loss/take-profit, checked each cycle against the latest bar's
# Low/High against the real average fill price -- see run_day_trade_cycle in
# t212bot/bot.py. Not a resting broker order, a polling check. 0 disables
# either side independently. Backtested: cut worst-case single-window
# drawdown roughly in half with no meaningful cost to average return.
DAYTRADE_STOP_LOSS_PCT=0.01
DAYTRADE_TAKE_PROFIT_PCT=0.02

# News-driven bot (`python main.py news`) -- free Yahoo Finance RSS headlines
# scored by a finance lexicon, traded as a few-day post-news drift with price
# confirmation. See README "News trading". No API key needed. All of these
# are untuned starting points: run it dry for a few weeks to build
# state/news.json, then `python main.py backtest --news` before changing them
# or arming it. Thresholds are on the -1..+1 headline score.
NEWS_BUY_THRESHOLD=0.35
NEWS_SELL_THRESHOLD=-0.35
NEWS_MIN_HEADLINES=3        # scorable headlines needed before a score counts
NEWS_HALF_LIFE_HOURS=12     # a headline's weight halves every 12h...
NEWS_MAX_AGE_HOURS=48       # ...and is ignored entirely past 48h
NEWS_MAX_HOLD_DAYS=3        # force-exit a news position after this many calendar days
NEWS_STOP_LOSS_PCT=0.03     # polling stop/take-profit vs the day's Low/High; 0 disables either
NEWS_TAKE_PROFIT_PCT=0.06
NEWS_MAX_CHASE_PCT=0.05     # don't buy if today's move is already past this; 0 disables
NEWS_TREND_FILTER_DAYS=20   # only buy above this SMA; 0 disables
# Sector read-through: a symbol without enough headlines of its own borrows
# its sector peers' consensus x this discount (0 disables).
NEWS_PEER_DISCOUNT=0.5
# Headline scorer: "lexicon" (free, deterministic) or "llm" (Claude via the
# anthropic package; needs ANTHROPIC_API_KEY; falls back to the lexicon on
# any failure). claude-haiku-5-5 is the cheap model option.
NEWS_SCORER=lexicon
NEWS_LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# Event study -- "how did similar news move this stock before?" (README
# "News trading"). Logged for every news signal; only blocks entries with
# EVENT_STUDY_GATE=true. EDGAR 8-K lookups identify themselves to the SEC
# with SEC_USER_AGENT -- put a contact in it if you run this seriously.
EVENT_STUDY_ENABLED=true
EVENT_STUDY_GATE=false
EVENT_STUDY_MIN_SAMPLES=5
EVENT_STUDY_HORIZON_DAYS=5
EVENT_STUDY_USE_EDGAR=true
SEC_USER_AGENT=t212bot/1.0 (https://github.com/isabaji/t212)

# Earnings-calendar awareness (all three bots): no new position when the
# symbol reports within this many days (the news bot is still allowed on the
# report day itself). 0 disables.
EARNINGS_BLACKOUT_DAYS=2

# Market-regime filter (all three bots): no new entries while SPY is below
# its REGIME_SMA_DAYS SMA or VIX is above the block level; sizes halved above
# the scale level. Exits are never affected. `backtest --regime-filter`
# applies the same SPY rule historically so you can compare with/without.
REGIME_FILTER_ENABLED=true
REGIME_SMA_DAYS=50
REGIME_VIX_SCALE_ABOVE=25
REGIME_VIX_BLOCK_ABOVE=35

# Comma-separated Yahoo Finance symbols to scan
WATCHLIST=AAPL,MSFT,GOOGL,AMZN,NVDA,META,TSLA,JPM,V,UNH,HD,XOM,JNJ,PG,DIS,AVGO,CRM,NFLX,NKE,MCD,BAC,MA,PFE,ABBV,CVX,KO,WMT,BA,CAT,NEE

# Risk settings
MAX_POSITION_PCT=0.35      # hard ceiling: max 35% of account value per position (scaled down by signal strength -- see below)
MAX_OPEN_POSITIONS=10      # up to 10 * MAX_POSITION_PCT of account value invested at once
CASH_BUFFER_PCT=0.05       # keep 5% of account value in cash

# Volatility-aware position sizing (see README): position size targets losing
# about RISK_PER_TRADE_PCT of the account if price moves ATR_MULTIPLE x ATR
# against it -- a volatile stock gets a smaller position than a calm one for
# the same dollar risk. MAX_POSITION_PCT above still applies as a hard cap.
RISK_PER_TRADE_PCT=0.01
ATR_MULTIPLE=2.0
ATR_PERIOD=14

# Daily target/loss-limit (not a guarantee — see README). Once realized gains
# for the day reach the target, new entries pause; same for losses hitting
# the limit. Shared across both bots, resets at UTC midnight.
DAILY_PROFIT_TARGET_PCT=0.0075   # 0.75% — stop opening new positions once hit
DAILY_LOSS_LIMIT_PCT=0.01        # 1% — stop opening new positions once hit

# Per-symbol losing-streak circuit breaker (rule-based, not ML — see README).
# After this many losses in a row on one symbol, pause new entries on just
# that symbol for the cooldown period, then resume with a reset streak.
LOSING_STREAK_LIMIT=3
LOSING_STREAK_COOLDOWN_DAYS=5

# Portfolio-level risk (see README): caps that look at the whole account
# rather than one symbol at a time.
# Max fraction of account value held in any one sector at once (t212bot/sectors.py),
# so a handful of correlated names (e.g. big tech) can't fill every open slot.
MAX_SECTOR_EXPOSURE_PCT=0.35
# Account-wide drawdown throttle: once realized returns fall this far below
# their high-water mark, both bots stop opening new positions until it
# recovers to less than half this threshold.
MAX_PORTFOLIO_DRAWDOWN_PCT=0.15
